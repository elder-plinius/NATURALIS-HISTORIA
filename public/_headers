/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/corpus/search/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/corpus/manifest.json
  Cache-Control: public, no-cache, must-revalidate
  X-Content-Type-Options: nosniff

/corpus/book-*.json
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/corpus/corrections.json
  Cache-Control: public, no-cache, must-revalidate
  X-Content-Type-Options: nosniff

/read/*
  Cache-Control: public, no-cache, must-revalidate
  X-Content-Type-Options: nosniff

/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self'; media-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'; frame-ancestors 'none'; worker-src 'none'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none
